{
  "name": "openfolio",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "dev": "pnpm --filter @openfolio/mac dev",
    "dev:web": "pnpm --filter @openfolio/web dev",
    "dev:hosted": "pnpm --filter @openfolio/hosted dev",
    "hosted:env": "bash scripts/sync-hosted-env.sh",
    "hosted:jwt": "node scripts/generate-hosted-jwt.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r typecheck",
    "qa": "pnpm typecheck && pnpm test && pnpm audit --audit-level moderate",
    "bench:search": "node scripts/benchmark-search.mjs"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.16",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "tmp@<0.2.6": ">=0.2.6",
      "fast-uri@<=3.1.3": "3.1.4",
      "sharp@<0.35.0": "0.35.3",
      "ip-address@<=10.1.0": ">=10.1.1",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "brace-expansion@>=1.0.0 <1.1.16": "1.1.16",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "@isaacs/brace-expansion": ">=5.0.1",
      "rollup": ">=4.59.0",
      "hono": ">=4.12.25",
      "@hono/node-server": ">=2.0.5",
      "qs": ">=6.15.2",
      "jsondiffpatch": ">=0.7.2",
      "ajv@<6.14.0": ">=6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "protobufjs": ">=7.5.5",
      "happy-dom": ">=20.8.9",
      "plist>@xmldom/xmldom": "0.8.13",
      "speech-rule-engine>@xmldom/xmldom": "0.9.10",
      "postcss": ">=8.5.10",
      "dompurify": ">=3.4.11",
      "mermaid@>=11.0.0-alpha.1 <=11.14.0": ">=11.15.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "ansi-to-react>linkify-it": "5.0.2",
      "onnxruntime-node>adm-zip": ">=0.6.0",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "uuid": ">=14.0.0",
      "esbuild": ">=0.28.1",
      "@develar/schema-utils>ajv": "6.14.0",
      "@develar/schema-utils>ajv-keywords": "3.5.2"
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
